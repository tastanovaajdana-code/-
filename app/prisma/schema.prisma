datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

model AdminUser {
  id           String   @id @default(cuid())
  login        String   @unique
  passwordHash String
  role         String   @default("admin") // "admin" | "curator"
  displayName  String?
  contact      String?
  createdAt    DateTime @default(now())
  curatedGroups Group[] @relation("GroupCurator")
}

model Group {
  id         String     @id @default(cuid())
  name       String     @unique
  createdAt  DateTime   @default(now())
  curatorId  String?
  curator    AdminUser? @relation("GroupCurator", fields: [curatorId], references: [id], onDelete: SetNull)
  attempts   Attempt[]
}

model Test {
  id          String     @id @default(cuid())
  title       String
  description String?
  track       String     @default("ort") // "ort" | "manas"
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  sections    Section[]
  attempts    Attempt[]
  lessons     Lesson[]
}

model Section {
  id               String     @id @default(cuid())
  testId           String
  test             Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  title            String
  order            Int        @default(0)
  timeLimitMinutes Int        @default(30)
  maxScore         Float?
  questions        Question[]
  passages         Passage[]
  results          AttemptSectionResult[]
}

model Passage {
  id        String     @id @default(cuid())
  sectionId String
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title     String?
  text      String?    @db.Text
  imageUrl  String?    @db.Text
  order     Int        @default(0)
  questions Question[]
}

model Question {
  id            String   @id @default(cuid())
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  passageId     String?
  passage       Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)
  text          String
  type          String   @default("single") // single | multiple | text
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  optionE       String?
  correctAnswer String   // "option_b" | "option_a,option_c" | free text
  points        Float    @default(1)
  order         Int      @default(0)
  imageUrl      String?  @db.Text
  explanation   String?  @db.Text
  answers       Answer[]
}

model Attempt {
  id           String    @id @default(cuid())
  studentFio   String
  studentEmail String?
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  testId       String
  test         Test      @relation(fields: [testId], references: [id])
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  totalScore   Float     @default(0)
  sectionResults AttemptSectionResult[]

  @@unique([testId, studentEmail])
}

model AttemptSectionResult {
  id            String    @id @default(cuid())
  attemptId     String
  attempt       Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section   @relation(fields: [sectionId], references: [id])
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  correctCount  Int       @default(0)
  totalQuestions Int      @default(0)
  score         Float     @default(0)
  answers       Answer[]

  @@unique([attemptId, sectionId])
}

model University {
  id        String      @id @default(cuid())
  name      String      @unique
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  programs  Program[]
  goals     TrackGoal[]
}

model Program {
  id           String      @id @default(cuid())
  universityId String
  university   University  @relation(fields: [universityId], references: [id], onDelete: Cascade)
  name         String
  order        Int         @default(0)
  goals        TrackGoal[]

  @@unique([universityId, name])
}

model TrackGoal {
  id           String      @id @default(cuid())
  email        String
  track        String      // "ort" | "manas"
  targetScore  Int?
  targetDate   DateTime?
  universityId String?
  university   University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  programId    String?
  program      Program?    @relation(fields: [programId], references: [id], onDelete: SetNull)
  updatedAt    DateTime    @updatedAt

  @@unique([email, track])
}

model WeeklyPlan {
  id           String   @id @default(cuid())
  email        String   @unique
  hoursPerWeek Int
  updatedAt    DateTime @updatedAt
}

model Subject {
  id        String    @id @default(cuid())
  track     String    // "ort" | "manas"
  name      String
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  lessons   Lesson[]

  @@unique([track, name])
}

model Lesson {
  id              String            @id @default(cuid())
  subjectId       String
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title           String
  videoUrl        String?           @db.Text
  description     String?           @db.Text
  durationMinutes Int?
  practiceType    String            @default("none") // "none" | "test" | "text"
  practiceTestId  String?
  practiceTest    Test?             @relation(fields: [practiceTestId], references: [id], onDelete: SetNull)
  practiceText    String?           @db.Text
  dueDate         DateTime?
  order           Int               @default(0)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  progress        LessonProgress[]
}

model LessonProgress {
  id           String    @id @default(cuid())
  lessonId     String
  lesson       Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentEmail String
  watchedAt    DateTime?
  practiceDone Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  @@unique([lessonId, studentEmail])
}

model Answer {
  id                     String                @id @default(cuid())
  sectionResultId        String
  sectionResult          AttemptSectionResult  @relation(fields: [sectionResultId], references: [id], onDelete: Cascade)
  questionId             String
  question               Question              @relation(fields: [questionId], references: [id], onDelete: Cascade)
  givenAnswer            String
  isCorrect              Boolean               @default(false)

  @@unique([sectionResultId, questionId])
}
