datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String @id @default(cuid())
  login        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Group {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  attempts  Attempt[]
}

model Test {
  id          String    @id @default(cuid())
  title       String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  sections    Section[]
  attempts    Attempt[]
}

model Section {
  id               String     @id @default(cuid())
  testId           String
  test             Test       @relation(fields: [testId], references: [id], onDelete: Cascade)
  title            String
  order            Int        @default(0)
  timeLimitMinutes Int        @default(30)
  maxScore         Float?
  questions        Question[]
  results          AttemptSectionResult[]
}

model Question {
  id            String   @id @default(cuid())
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  text          String
  type          String   @default("single") // single | multiple | text
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  correctAnswer String   // "option_b" | "option_a,option_c" | free text
  points        Float    @default(1)
  order         Int      @default(0)
  answers       Answer[]
}

model Attempt {
  id           String    @id @default(cuid())
  studentFio   String
  groupId      String
  group        Group     @relation(fields: [groupId], references: [id])
  testId       String
  test         Test      @relation(fields: [testId], references: [id])
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  totalScore   Float     @default(0)
  sectionResults AttemptSectionResult[]
}

model AttemptSectionResult {
  id            String    @id @default(cuid())
  attemptId     String
  attempt       Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section   @relation(fields: [sectionId], references: [id])
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  correctCount  Int       @default(0)
  totalQuestions Int      @default(0)
  score         Float     @default(0)
  answers       Answer[]

  @@unique([attemptId, sectionId])
}

model Answer {
  id                     String                @id @default(cuid())
  sectionResultId        String
  sectionResult          AttemptSectionResult  @relation(fields: [sectionResultId], references: [id], onDelete: Cascade)
  questionId             String
  question               Question              @relation(fields: [questionId], references: [id])
  givenAnswer            String
  isCorrect              Boolean               @default(false)

  @@unique([sectionResultId, questionId])
}
